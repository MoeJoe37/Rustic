#document
  doctype name="html" public="" system=""
  element namespace="http://www.w3.org/1999/xhtml" prefix=null local="html"
    attribute namespace=null prefix=null local="lang" value="en"
    element namespace="http://www.w3.org/1999/xhtml" prefix=null local="head"
      element namespace="http://www.w3.org/1999/xhtml" prefix=null local="title"
        text "Rustic & dump-dom"
      text "\n"
      element namespace="http://www.w3.org/1999/xhtml" prefix=null local="style"
        text "p > span { color: red }"
      text "\n"
      element namespace="http://www.w3.org/1999/xhtml" prefix=null local="script"
        text "if (a < b) document.write(\"<p>\")"
      text "\n"
    element namespace="http://www.w3.org/1999/xhtml" prefix=null local="body"
      attribute namespace=null prefix=null local="class" value="x"
      attribute namespace=null prefix=null local="id" value="merged"
      element namespace="http://www.w3.org/1999/xhtml" prefix=null local="p"
        text "Unclosed "
        element namespace="http://www.w3.org/1999/xhtml" prefix=null local="span"
          text "café 🙂\n"
      element namespace="http://www.w3.org/1999/xhtml" prefix=null local="p"
        text "Second paragraph"
      element namespace="http://www.w3.org/1999/xhtml" prefix=null local="div"
        text "Block"
      text "\n"
      element namespace="http://www.w3.org/1999/xhtml" prefix=null local="p"
      element namespace="http://www.w3.org/1999/xhtml" prefix=null local="br"
      element namespace="http://www.w3.org/1999/xhtml" prefix=null local="hr"
      comment " local fixture "
      text "\ntrailing\n"
